class Converters {
  /// 安全取日期：GQL 有時是 {isoString}, 有時直接是字串
  static fun extractDate(value) -> string {
    if(value == null) return ""
    if(value is Map) {
      var iso = value["isoString"]
      if(iso != null) return iso.toString()
      var year = value["year"]
      if(year != null) return year.toString()
      return ""
    }
    return value.toString()
  }

  /// 安全取圖片清單：接受 coverArt {sources} / images [..] / null
  static fun extractImages(value) -> List {
    if(value == null) return []
    if(value is Map) {
      var sources = value["sources"]
      if(sources is List) return sources
      return []
    }
    return []
  }

  /// 安全取 spotify 外部連結
  static fun extractSpotifyUrl(node: Map, fallback: string) -> string {
    if(node is Map) {
      var sp = node["spotify"]
      if(sp != null) return sp.toString()
    }
    return fallback
  }

  static fun extractList(value: Map) -> List {
    if(value == null) return []
    if(value is List) return value
    return []
  }

  static fun paginated(data: Map, convertItems: (items: List) -> List) -> Map {
    var hasMore = data["total"] > (data["offset"] + data["items"].length)
    
    return {
      limit: data["limit"],
      nextOffset: hasMore ? data["offset"] + data["limit"] : null,
      hasMore: hasMore,
      total: data["total"],
      items: convertItems(
        data["items"].where((item)=> item != null).toList()
      ),
    }.toJson()
  }
  
  static fun fullTracks(tracks: List) -> List {
    if(tracks == null || tracks.isEmpty) {
      return []
    }
    
    var modified = []
    
    for(var track in tracks) {
      if(track == null) {
        modified.add(null)
        continue
      }
      
      var modifiedTrack = {
        id: track["id"],
        name: track["name"],
        externalUri: track["external_urls"]["spotify"] ?? "https://open.spotify.com/track/${track["id"]}",
        explicit: track["explicit"] ?? false,
        durationMs: track["duration_ms"] ?? 0,
        isrc: track["external_ids"]?["isrc"] ?? "",
        artists: simpleArtists(track["artists"]),
        album: simpleAlbums([track["album"]])[0],
      }.toJson()

      modified.add(modifiedTrack)
    }

    return modified
  }

  static fun fullAlbums(albums: List) -> List {
    if(albums == null || albums.isEmpty) {
      return
    }

    var modified = []

    for(var album in albums) {
      var modifiedAlbum = {
        id: album["id"],
        name: album["name"],
        externalUri: album["external_urls"]["spotify"] ?? "https://open.spotify.com/album/${album["id"]}",
        releaseDate: album["release_date"] ?? "",
        releaseDatePrecision: album["release_date_precision"] ?? "year",
        totalTracks: album["total_tracks"] ?? 0,
        artists: simpleArtists(album["artists"]),
        images: album["images"],
        albumType: (album["album_type"] == "ep" || album["album_type"] == "audiobook" ? "compilation" : album["album_type"]) ?? "album",
        totalTracks: album["total_tracks"],
        recordLabel: album["label"],
        genres: album["genres"]
      }.toJson()

      modified.add(modifiedAlbum)
    }
    
    return modified
  }

  static fun simpleAlbums(albums: List) -> List {
    if(albums == null || albums.isEmpty) {
      return []
    }
    
    var modified = []

    for(var album in albums) {
      var albumModified = {
        id: album["id"],
        name: album["name"],
        externalUri: album["external_urls"]["spotify"] ?? "https://open.spotify.com/album/${album["id"]}",
        releaseDate: album["release_date"],
        releaseDatePrecision: album["release_date_precision"],
        artists: simpleArtists(album["artists"]),
        images: album["images"],
        albumType: (album["album_type"] == "ep" || album["album_type"] == "audiobook" ? "compilation" : album["album_type"]) ?? "album",
      }.toJson()

      modified.add(albumModified)
    }
    
    return modified
  }

  static fun fullArtists(artists: List) -> List {
    if(artists == null || artists.isEmpty) {
      return []
    }
    
    var modified = []

    for(var artist in artists) {
      var artistModified = {
        id: artist["id"],
        name: artist["name"],
        externalUri: artist["external_urls"]["spotify"] ?? "https://open.spotify.com/artist/${artist["id"]}",
        images: artist["images"],
        genres: artist["genres"] ?? [],
        followers: artist["followers"]?["total"],
      }.toJson()

      modified.add(artistModified)
    }
    
    return modified 
  }

  static fun simpleArtists(artists: List) -> List {
    if(artists == null || artists.isEmpty) {
      return []
    }
    
    var modified = []

    for(var artist in artists) {
      var artistModified = {
        id: artist["id"],
        name: artist["name"],
        externalUri: artist["external_urls"]["spotify"] ?? "https://open.spotify.com/artist/${artist["id"]}",
        images: artist["images"], // Optional
      }.toJson()

      modified.add(artistModified)
    }

    return modified
  }

  static fun simpleUser(data: Map) -> Map {
    return {
        id: data["id"],
        name: data["display_name"],
        images: data["images"],
        externalUri: data["external_urls"]["spotify"] ?? "https://open.spotify.com/user/${data["id"]}",
      }.toJson()
  }

  static fun simplePlaylistsFromLibraryV3(playlists: List) -> List {
    if (playlists == null || playlists.isEmpty) {
      return []
    }
    var modified = []
    for (var playlist in playlists) {
      var playlistModified = {
        id: playlist["id"],
        name: playlist["name"],
        description: playlist["description"],
        images: playlist["images"],
        externalUri: playlist["external_urls"]["spotify"] ?? "https://open.spotify.com/playlist/${playlist["id"]}",
        owner: simpleUser(playlist["owner"]),
      }.toJson()

      modified.add(playlistModified)
    }

    return modified
  }

  static fun fullPlaylists(playlists: List) -> List {
    if (playlists == null || playlists.isEmpty) {
      return []
    }
    var modified = []
    for (var playlist in playlists) {
      var playlistModified = {
        id: playlist["id"],
        name: playlist["name"],
        description: playlist["description"],
        images: playlist["images"],
        externalUri: playlist["external_urls"]["spotify"] ?? "https://open.spotify.com/playlist/${playlist["id"]}",
        owner: simpleUser(playlist["owner"]),
        collaborative: playlist["collaborative"] ?? false,
        public: playlist["public"] ?? false,
      }.toJson()

      modified.add(playlistModified)
    }

    return modified
  }

  static fun simpleShows(shows: List) -> List {
    if(shows == null || shows.isEmpty) {
      return []
    }

    var modified = []

    for(var show in shows) {
      if(show == null) {
        modified.add(null)
        continue
      }

      var rawUri = show["uri"]
      var id = show["id"] ?? (rawUri != null ? rawUri.toString().split(":").last : "")

      var publisher = show["publisher"]
      var publisherName = ""
      if(publisher is Map) {
        var np = publisher["name"]
        if(np != null) publisherName = np.toString()
      } else if(publisher != null) {
        publisherName = publisher.toString()
      }

      var images = Converters.extractList(show["images"])
      if(images.isEmpty && show["coverArt"] is Map) {
        images = Converters.extractList(show["coverArt"]["sources"])
      }

      var showModified = {
        id: id,
        name: show["name"],
        externalUri: Converters.extractSpotifyUrl(show["external_urls"], "https://open.spotify.com/show/${id}"),
        releaseDate: Converters.extractDate(show["release_date"] ?? show["releaseDate"]),
        releaseDatePrecision: "day",
        artists: [],
        images: images,
        albumType: "compilation",
        totalTracks: show["total_episodes"] ?? 0,
        recordLabel: publisherName,
        genres: [],
        description: show["description"] ?? "",
      }.toJson()

      modified.add(showModified)
    }

    return modified
  }

  static fun fullEpisodes(episodes: List) -> List {
    if(episodes == null || episodes.isEmpty) {
      return []
    }

    var modified = []

    for(var episode in episodes) {
      if(episode == null) {
        modified.add(null)
        continue
      }

      var show = episode["show"]
      if(show == null) {
        show = episode["podcastV2"]?["data"]
      }
      var showId = show?["id"] ?? (show?["uri"] != null ? show["uri"].toString().split(":").last : "")
      var showName = show?["name"]?.toString() ?? ""
      var showImages = show != null ? Converters.extractList(show["images"]) : []
      if(showImages.isEmpty && show != null && show["coverArt"] is Map) {
        showImages = Converters.extractList(show["coverArt"]["sources"])
      }

      var rawUri = episode["uri"]
      var episodeId = episode["id"] ?? (rawUri != null ? rawUri.toString().split(":").last : "")

      var durationMs = episode["duration_ms"]
      if(durationMs == null && episode["duration"] is Map) {
        durationMs = episode["duration"]["totalMilliseconds"] ?? 0
      }

      var episodeImages = Converters.extractList(episode["images"])
      if(episodeImages.isEmpty && episode["coverArt"] is Map) {
        episodeImages = Converters.extractList(episode["coverArt"]["sources"])
      }

      var modifiedEpisode = {
        id: episodeId,
        name: episode["name"],
        externalUri: Converters.extractSpotifyUrl(episode["external_urls"], "https://open.spotify.com/episode/${episodeId}"),
        explicit: episode["explicit"] ?? false,
        durationMs: durationMs ?? 0,
        isrc: "",
        artists: showName.isNotEmpty ? [{
          id: showId,
          name: showName,
          externalUri: "https://open.spotify.com/show/${showId}",
          images: showImages,
        }.toJson()] : [],
        album: {
          id: showId,
          name: showName,
          externalUri: showId.isNotEmpty ? "https://open.spotify.com/show/${showId}" : "",
          releaseDate: Converters.extractDate(episode["release_date"] ?? episode["releaseDate"]),
          releaseDatePrecision: "day",
          images: showImages.isEmpty ? episodeImages : showImages,
          albumType: "compilation",
        }.toJson(),
        // 供 podcast 音源使用（Show→Album、Episode→Track 映射的自訂欄位）
        showName: showName,
        episodeName: episode["name"],
        description: episode["description"] ?? "",
      }.toJson()

      modified.add(modifiedEpisode)
    }

    return modified
  }
}

export { Converters }