import { SpotifyGqlApi } from '../../dependencies/hetu_spotify_gql_client/lib/assets/hetu/spotify_gql_api_client.ht'
import { Converters } from '../converter/converter.ht'

class EpisodeEndpoint {
  var client: SpotifyGqlApi

  construct (this.client)

  fun getEpisode(id: string) {
    return client.show.getEpisode(id).then((data) {
      return Converters.fullEpisodes([data])[0]
    })
  }

  fun save(episodeIds: List) async {
    await client.show.saveEpisodes(episodeIds)
    return true
  }

  fun unsave(episodeIds: List) async {
    await client.show.unsaveEpisodes(episodeIds)
    return true
  }
}

export { EpisodeEndpoint }