import "module:std" as std

import { SpotifyAuthEndpoint } from "./auth.ht"

var HttpClient = std.HttpClient
var HttpResponse = std.HttpResponse
var RequestOptions = std.RequestOptions
var HttpBaseOptions = std.HttpBaseOptions
var HttpResponseType = std.HttpResponseType

class PodcastConverter {
  /// Normalize episode title for fuzzy matching
  static fun normalizeName(name: string) -> string {
    if (name == null) return ""
    return name
      .replaceAll(Regex("[【\\[].*?[】\\]]"), "")
      .replaceAll(Regex("[<>:\"/\\|?*&]"), "")
      .replaceAll(" ", "")
      .toLowerCase()
      .trim()
  }

  /// Extract text between startTag and endTag (string-based RSS parsing)
  static fun pickBetween(text: string, startTag: string, endTag: string) -> string {
    if (text == null) return ""
    var parts = text.split(startTag)
    if (parts.length < 2) return ""
    var tail = parts[1]
    var eparts = tail.split(endTag)
    if (eparts.isEmpty) return ""
    return eparts[0].trim()
  }

  /// Parse RSS feed items: title / enclosure url / duration
  static fun parseRssFeed(xml: string) -> List {
    if (xml == null || xml.isEmpty) {
      return []
    }

    var items = xml.split("<item>")
    var result = []

    for (var i = 1; i < items.length; i++) {
      var itemXml = items[i]

      var title = PodcastConverter.pickBetween(itemXml, "<title>", "</title>")
      title = title.replaceAll("<![CDATA[", "").replaceAll("]]>", "")
      title = title.replaceAll("&amp;", "&").trim()

      var encTag = PodcastConverter.pickBetween(itemXml, "<enclosure", ">")
      var audioUrl = PodcastConverter.pickBetween(encTag, 'url="', '"')
      audioUrl = audioUrl.replaceAll("&amp;", "&")

      if (title.isEmpty || audioUrl.isEmpty) {
        continue
      }

      var durationStr = PodcastConverter.pickBetween(itemXml, "<itunes:duration>", "</itunes:duration>")

      result.add({
        index: i,
        title: title,
        audioUrl: audioUrl,
        duration: PodcastConverter.durationToMs(durationStr),
      }.toJson())
    }

    return result
  }

  /// itunes:duration ("HH:MM:SS" or plain seconds) -> milliseconds
  static fun durationToMs(d: string) -> int {
    if (d == null || d.isEmpty) return 0
    var parts = d.split(":")
    var total = 0
    var mult = 1
    for (var i = parts.length - 1; i >= 0; i--) {
      var seg = parts[i].trim()
      if (seg.isEmpty) continue
      total += int.parse(seg) * mult
      mult *= 60
    }
    return total * 1000
  }

  static fun guessContainer(url: string) -> string {
    if (url == null) return "mp3"
    if (url.endsWith(".m4a")) return "m4a"
    if (url.endsWith(".aac")) return "aac"
    if (url.endsWith(".ogg")) return "ogg"
    if (url.endsWith(".wav")) return "wav"
    if (url.endsWith(".flac")) return "flac"
    return "mp3"
  }

  static fun guessCodec(container: string) -> string {
    if (container == "m4a" || container == "aac") return "aac"
    return "mp3"
  }

  /// Extract show name from getEpisodeOrChapter response (never throws)
  static fun extractShowName(data) -> string {
    if (data == null) return ""
    var episode = data["data"]?["episodeUnionV2"]
    if (episode == null) return ""
    var podcast = episode["podcastV2"]?["data"]
    if (podcast == null) return ""
    return podcast["name"]?.toString() ?? ""
  }

  /// RSS episode -> Spotube match object (audioUrl is direct file)
  static fun toMatchObject(episode: Map, show: Map) -> Map {
    return {
      id: "rss:${show["collectionId"]}:${episode["index"]}",
      title: episode["title"],
      artists: [show["collectionName"]],
      duration: episode["duration"] ?? 0,
      thumbnail: show["artworkUrl100"] ?? "",
      externalUri: episode["audioUrl"],
      audioUrl: episode["audioUrl"],
    }.toJson()
  }
}

class PodcastAudioSourceEndpoint {
  var client: HttpClient
  var safeClient: HttpClient
  var auth: SpotifyAuthEndpoint

  construct (this.auth) {
    client = HttpClient()
    // validateStatus always true: HTTP errors never throw, just return empty
    safeClient = HttpClient(
      HttpBaseOptions(
        validateStatus: (status) => true
      )
    )
  }

  // List of containers and their supported qualities
  get supportedPresets -> List {
    return [
      { type: "lossy", name: "mp3", qualities: [ { bitrate: 128000 }, { bitrate: 96000 } ] }.toJson(),
      { type: "lossy", name: "m4a", qualities: [ { bitrate: 128000 } ] }.toJson(),
    ]
  }

  /// Search iTunes for the show's feedUrl, retrying with shorter names
  /// (e.g. "科技浪 Tech.wav" -> 0 results -> "科技浪" -> hit)
  /// @returns Future<List<Map>> (podcast shows)
  fun searchItunes(terms: List) -> List {
    if (terms.isEmpty) {
      return []
    }

    var term = terms.join(" ")
    var searchUrl = "https://itunes.apple.com/search?term=${term}&media=podcast&limit=5"

    return safeClient.get_req(
      searchUrl,
      options: RequestOptions(
        headers: {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }.toJson(),
      ),
    ).then((res: HttpResponse) {
      var results = res.data["results"] ?? []

      var podcasts = results
        .where((r) => r["kind"] == "podcast" && r["feedUrl"] != null && r["feedUrl"].isNotEmpty)
        .toList()

      if (podcasts.isNotEmpty) {
        return podcasts
      }

      var shorter = terms.sublist(0, terms.length - 1)
      if (shorter.isEmpty) {
        return []
      }
      return searchItunes(shorter)
    })
  }

  /// Fetch & parse RSS feed directly (Playlist_Administrator approach)
  /// @returns Future<List<Map>>
  fun fetchRssEpisodes(feedUrl: string) -> List {
    if (feedUrl == null || feedUrl.isEmpty) {
      return []
    }

    return safeClient.get_req(
      feedUrl,
      options: RequestOptions(
        responseType: HttpResponseType.plain,
        headers: {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }.toJson(),
      ),
    ).then((res: HttpResponse) {
      return PodcastConverter.parseRssFeed(res.data)
    })
  }

  /// RSS audio source: iTunes -> feedUrl -> RSS parse -> title match -> direct audio
  fun rssMatches(showName: string, episodeTitle: string) -> List {
    if (showName.isEmpty || episodeTitle.isEmpty) {
      return []
    }

    var terms = showName.trim().split(" ")

    return searchItunes(terms).then((podcasts) {
      if (podcasts.isEmpty) {
        return []
      }

      var show = podcasts[0]

      return fetchRssEpisodes(show["feedUrl"]).then((episodes) {
        if (episodes.isEmpty) {
          return []
        }

        var targetEpisode = episodes.firstWhere(
          (e) {
            var rssTitle = PodcastConverter.normalizeName(e["title"])
            var searchTitle = PodcastConverter.normalizeName(episodeTitle)
            return rssTitle.contains(searchTitle) || searchTitle.contains(rssTitle)
          },
          orElse: () => null
        )

        if (targetEpisode == null) {
          return []
        }

        return [PodcastConverter.toMatchObject(targetEpisode, show)]
      })
    })
  }

  /// Resolve show name from Spotify episode ID via getEpisodeOrChapter.
  /// Uses safeClient (never throws on HTTP errors).
  /// @returns Future<string>
  fun resolveShowName(episodeId: string) -> string {
    if (episodeId == null || episodeId.isEmpty) {
      return ""
    }
    if (auth.credentials == null) {
      return ""
    }
    var token = auth.credentials["accessToken"]
    if (token == null || token.isEmpty) {
      return ""
    }

    var payload = {
      "variables": { "uri": "spotify:episode:${episodeId}" },
      "operationName": "getEpisodeOrChapter",
      "extensions": {
        "persistedQuery": {
          "version": 1,
          "sha256Hash": "3416929067571ac4b79db16716be3c6ea5f6265f7975a0ee94b1fc5ee1dc1e9d"
        }
      }
    }.toJson()

    return safeClient.post(
      "https://api-partner.spotify.com/pathfinder/v2/query",
      data: payload,
      options: RequestOptions(
        headers: {
          "Authorization": "Bearer ${token}",
          "app-platform": "WebPlayer",
        }.toJson(),
      ),
    ).then((res: HttpResponse) {
      return PodcastConverter.extractShowName(res.data)
    })
  }

  /// Find audio source for the given track (episode). RSS only.
  /// Resolves showName via Spotify API when the track lacks it.
  /// @param track - Map<SpotubeTrackObject>
  /// @returns Future<List<SpotubeAudioSourceMatchObject>>
  fun matches(track: Map) -> List {
    var episodeTitle = track["episodeName"] ?? track["name"] ?? ""
    var episodeId = track["id"]

    if (episodeTitle == null || episodeTitle.isEmpty) {
      return []
    }

    var showName = track["showName"] ?? track["album"]?["name"] ?? ""
    if (showName == null) {
      showName = ""
    }

    if (showName.isEmpty && episodeId != null && !episodeId.isEmpty) {
      return resolveShowName(episodeId).then((name) {
        if (name == null || name.isEmpty) {
          return []
        }
        return rssMatches(name.toString(), episodeTitle)
      })
    }

    return rssMatches(showName, episodeTitle)
  }

  /// Streams for the given match. RSS matches carry the direct audio URL.
  /// @param match - Map<SpotubeAudioSourceStreamObject>
  /// @returns Future<List<SpotubeAudioSourceStreamObject>>
  fun streams(match: Map) -> List {
    var audioUrl = match["audioUrl"]

    if (audioUrl == null || audioUrl.isEmpty) {
      return []
    }

    var container = PodcastConverter.guessContainer(audioUrl.toString())
    return [{
      "url": audioUrl,
      "container": container,
      "type": "lossy",
      "codec": PodcastConverter.guessCodec(container),
      "bitrate": 128000,
    }.toJson()]
  }
}

export { PodcastAudioSourceEndpoint }